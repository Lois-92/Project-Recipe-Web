<html>
    <head>
          <%- include('partials/header1.ejs')%>
        <link rel="stylesheet" href="/public/css/styles.css">
    </head>
   
   
    <body>
        <%- include('partials/navbar1.ejs')%>
        
        

        <div class="container mt-5">  <!--margin-top spacing -->

        <h1 style="font-size:60px;"> This is My Recipe</h1>

        
               
        <form action="/recipes/search"  method="GET" class="search-form">
           <!--create a form and send data to /recipes/search , route using GET method-->

            
            <!--Express cannot read id, it only reads form values using name--> <!-- this is what Express reads, becomes req.query.q in aap.js-->
            <input type="text" id="search-input" class="form-control" name="q" placeholder="Search by name " required >
                                                                     

            <div class="mt-3">
             <button type="submit" id="Search-button" class="btn btn-light" >Search</button>
             <br>
            </div>


            <img class="img1" src="/public/images/Home.jpg" alt="food">

            

        </form>
       
        <p>
            Reflecting on the profound connection between food and memories
        </p>
        
        <h4><strong> <a href="Recipes">Check Out Our Recipes</a> </strong></h4>
    </body>
</html>
