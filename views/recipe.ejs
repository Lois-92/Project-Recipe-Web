
<html>
    <head>
         <%- include('partials/header2.ejs')%>
         
         <link rel="stylesheet" href="/public/css/styles2.css"> 

        
    </head>

    <body>
    <%- include('partials/navbar1.ejs') %>

        <div class="recipe-container">

  
         <h1><%= recipe.recipetitle %></h1>  <!-- dispalys the recipe title from database-->
         <p><strong>Author:</strong> <%= recipe.username %></p>   

         <img src="/uploads/<%= recipe.image %>" width="300"  alt="<%= recipe.recipetitle %>" class="recipe-img">

         <h3>Ingredients</h3>
         <p><%= recipe.ingredients %></p>

         <h3>Instructions</h3>
         <p><%= recipe.instructions %></p>

         <a href="/recipes">← Back to recipes</a>
        </div>
    </body>
</html>