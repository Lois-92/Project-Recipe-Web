<html>
    <head>
    <%- include('partials/header1.ejs') %> 
    

    </head>
    
    <body>
         <%- include('partials/navbar1.ejs') %>
         
        <div>
            <h1>Login</h1>
            <br>
            <img class="img2" src="/public/images/login.avif" alt="Login">
           
         
             <div class="container text-center mt-5 ">

            <form action="/auth" method="post" class="login-form">

                
                 <input type="text" name="username" class="form-control" placeholder="User Name" id="username" required>
               
                

                <div class="mt-2">
                  <input type="password" name="password"  class="form-control" placeholder="Password" id="password" required>
                </div>

                <br><br>
                
                <button type="submit" class="btn btn-light">Login</button>
            </form>         
            <br>
            <h4> <a href="register">No Account ? Register</a></h4>
        </div>
    </body>
</html> 